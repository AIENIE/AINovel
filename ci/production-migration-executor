#!/usr/bin/python3
"""Sealed, fail-closed AINovel production migration executor."""

from __future__ import annotations

import hashlib
import json
import os
import pathlib
import re
import stat
import subprocess
import sys
from typing import Any


COMPONENT = "ai-novel"
PROJECT = "aienie_ai_novel_production"
LEDGER = "release/migrations/flyway-ledger.json"
ARTIFACT_MANIFEST = "release/production-migration-artifacts.json"
CONTAINER_ENTRYPOINT = "/app/bin/production-migration-entrypoint.sh"
DIGEST = re.compile(r"sha256:(?!0{64})[0-9a-f]{64}\Z")
IMAGE_REFERENCE = re.compile(r"ghcr\.io/aienie/ai-novel@sha256:(?!0{64})[0-9a-f]{64}\Z")
MIGRATION_PATH = re.compile(r"release/migrations/sql/V([1-9]|1[0-4])__[A-Za-z0-9_.-]+\.sql\Z")
RESTORE_REF = re.compile(
    r"/var/lib/aienie-production/product-executors/restore-points/ai-novel/[0-9a-f]{64}/checkpoint\.sql\Z"
)
IMAGE_BINDINGS = (("backend", "AINOVEL_BACKEND_IMAGE"), ("frontend", "AINOVEL_FRONTEND_IMAGE"))
PLATFORM = {
    "AIENIE_MIGRATION_MANIFEST_SHA256": "production-release-manifest-v4.json",
    "AIENIE_MIGRATION_PUBLICATION_RECEIPT_SHA256": "production-publication-receipt.json",
    "AIENIE_MIGRATION_BACKUP_CLOSURE_SHA256": "production-backup-closure.json",
}
PLATFORM_FILES = (
    ".aienie-platform/production-release-manifest-v4.json",
    ".aienie-platform/production-publication-receipt.json",
    ".aienie-platform/production-publication-receipt.json.sig",
)
PUBLICATION_KEYS = {
    "schema_version", "release_id", "canonical_component_id", "release_version", "source_commit",
    "artifact_sha256", "outer_manifest_sha256", "production_build_receipt_sha256",
    "production_build_signature_sha256", "registry_publication_receipt_sha256",
    "builder_installation_receipt_sha256", "offline_cache_receipt_sha256",
    "runtime_image_bindings_sha256", "runtime_image_evidence_sha256", "signing_key_sha256",
    "issued_at_utc",
}
CLOSURE_KEYS = {
    "schema_version", "release_id", "canonical_component_id", "release_version", "artifact_sha256",
    "outer_manifest_sha256", "publication_receipt_sha256", "publication_signature_sha256",
    "signing_key_sha256", "artifact_security_scan_sha256", "artifact_files", "artifact_files_sha256",
    "artifact_file_count", "artifact_total_bytes", "platform_files", "platform_files_sha256",
    "closure_pair", "capture_semantics", "protected_material_policy",
}


class ContractError(RuntimeError):
    pass


def canonical(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def digest_bytes(value: bytes) -> str:
    return "sha256:" + hashlib.sha256(value).hexdigest()


def digest_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return "sha256:" + digest.hexdigest()


def reject_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    value: dict[str, Any] = {}
    for key, child in pairs:
        if key in value:
            raise ContractError("duplicate JSON key")
        value[key] = child
    return value


def regular(path: pathlib.Path, modes: set[int] | None = None) -> os.stat_result:
    try:
        info = path.lstat()
    except OSError as error:
        raise ContractError("required file is unavailable") from error
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode) or path.resolve(strict=True) != path:
        raise ContractError("required path is not a canonical regular file")
    if modes is not None and stat.S_IMODE(info.st_mode) not in modes:
        raise ContractError("required file mode is invalid")
    return info


def strict_json(path: pathlib.Path) -> tuple[dict[str, Any], bytes]:
    regular(path)
    raw = path.read_bytes()
    if not raw or len(raw) > 16 * 1024 * 1024 or raw.startswith(b"\xef\xbb\xbf"):
        raise ContractError("JSON size or encoding marker is invalid")
    try:
        value = json.loads(raw.decode("utf-8", "strict"), object_pairs_hook=reject_duplicates)
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ContractError("JSON framing is invalid") from error
    if not isinstance(value, dict) or canonical(value) != raw:
        raise ContractError("JSON object is not canonical")
    return value, raw


def injected_digest(name: str) -> str:
    value = os.environ.get(name, "")
    if DIGEST.fullmatch(value) is None:
        raise ContractError("migration invocation digest is invalid")
    return value


def validate_platform(root: pathlib.Path) -> dict[str, str]:
    platform = root / ".aienie-platform"
    if not platform.is_dir() or platform.is_symlink() or platform.resolve(strict=True) != platform:
        raise ContractError("platform evidence directory is invalid")
    values: dict[str, tuple[dict[str, Any], bytes]] = {}
    observed: dict[str, str] = {}
    for environment_name, filename in PLATFORM.items():
        value, raw = strict_json(platform / filename)
        expected = injected_digest(environment_name)
        if digest_bytes(raw) != expected:
            raise ContractError("platform evidence digest drifted")
        values[filename] = (value, raw)
        observed[environment_name] = expected
    outer, outer_raw = values["production-release-manifest-v4.json"]
    publication, publication_raw = values["production-publication-receipt.json"]
    closure, _ = values["production-backup-closure.json"]
    artifact = injected_digest("AIENIE_MIGRATION_ARTIFACT_SHA256")
    bindings = outer.get("image_bindings")
    closure_images = outer.get("image_closure")
    release_id = outer.get("release_id")
    release_version = outer.get("release_version")
    if (
        outer.get("schema_version") != "v4"
        or outer.get("environment") != "production"
        or outer.get("operation") != "release"
        or outer.get("canonical_component_id") != COMPONENT
        or outer.get("component") != COMPONENT
        or outer.get("project_key") != COMPONENT
        or not isinstance(release_id, str) or not release_id
        or not isinstance(release_version, str) or not release_version
        or set(publication) != PUBLICATION_KEYS
        or publication.get("schema_version") != "aienie-production-publication-receipt-v1"
        or publication.get("canonical_component_id") != COMPONENT
        or publication.get("release_id") != release_id
        or publication.get("release_version") != release_version
        or publication.get("artifact_sha256") != artifact
        or publication.get("outer_manifest_sha256") != digest_bytes(outer_raw)
        or not isinstance(bindings, list) or len(bindings) != len(IMAGE_BINDINGS)
        or not isinstance(closure_images, list) or len(closure_images) != len(IMAGE_BINDINGS)
        or outer.get("image_bindings_digest") != digest_bytes(canonical(bindings))
        or outer.get("image_closure_digest") != digest_bytes(canonical(closure_images))
        or publication.get("runtime_image_bindings_sha256") != outer.get("image_bindings_digest")
        or set(closure) != CLOSURE_KEYS
        or closure.get("schema_version") != "aienie-production-backup-closure-v1"
        or closure.get("canonical_component_id") != COMPONENT
        or closure.get("release_id") != release_id
        or closure.get("release_version") != release_version
        or closure.get("artifact_sha256") != artifact
        or closure.get("outer_manifest_sha256") != digest_bytes(outer_raw)
        or closure.get("publication_receipt_sha256") != digest_bytes(publication_raw)
    ):
        raise ContractError("signed platform evidence binding drifted")
    references: list[str] = []
    for binding, (expected_role, expected_variable) in zip(bindings, IMAGE_BINDINGS, strict=True):
        if (
            not isinstance(binding, dict)
            or set(binding) != {"environment_variable", "reference", "role"}
            or binding.get("role") != expected_role
            or binding.get("environment_variable") != expected_variable
            or not isinstance(binding.get("reference"), str)
            or IMAGE_REFERENCE.fullmatch(binding["reference"]) is None
        ):
            raise ContractError("signed runtime image binding drifted")
        references.append(binding["reference"])
        observed[expected_variable] = binding["reference"]
    if len(set(references)) != len(references) or closure_images != sorted(references):
        raise ContractError("signed runtime image closure drifted")
    inventory = closure.get("artifact_files")
    if (
        not isinstance(inventory, list)
        or closure.get("artifact_file_count") != len(inventory)
        or closure.get("artifact_files_sha256") != digest_bytes(canonical(inventory))
        or closure.get("artifact_total_bytes") != sum(
            item.get("size", -1) if isinstance(item, dict) and isinstance(item.get("size"), int) else -1
            for item in inventory
        )
        or closure.get("closure_pair") != [
            ".aienie-platform/production-backup-closure.json",
            ".aienie-platform/production-backup-closure.json.sig",
        ]
        or closure.get("capture_semantics") != "exact-listed-files-plus-signed-closure-pair-only"
        or closure.get("protected_material_policy")
        != "env-admin-cap-private-key-and-protected-overlays-excluded"
    ):
        raise ContractError("artifact inventory is invalid")
    seen: set[str] = set()
    for item in inventory:
        if (
            not isinstance(item, dict)
            or set(item) != {"path", "sha256", "size"}
            or DIGEST.fullmatch(str(item.get("sha256", ""))) is None
            or not isinstance(item.get("size"), int)
            or isinstance(item.get("size"), bool)
            or item["size"] < 0
        ):
            raise ContractError("artifact inventory entry is invalid")
        relative = item.get("path")
        if not isinstance(relative, str) or relative in seen or relative.startswith("/") \
                or ".." in pathlib.PurePosixPath(relative).parts:
            raise ContractError("artifact inventory path is invalid")
        seen.add(relative)
        candidate = root.joinpath(*pathlib.PurePosixPath(relative).parts)
        info = regular(candidate)
        if info.st_size != item["size"] or digest_file(candidate) != item["sha256"]:
            raise ContractError("sealed artifact inventory drifted")
    for required in (LEDGER, ARTIFACT_MANIFEST, "release/production-migration-executor",
                     "backend/production-migration-entrypoint.sh"):
        if required not in seen:
            raise ContractError("migration artifact is absent from signed inventory")
    platform_inventory = closure.get("platform_files")
    if not isinstance(platform_inventory, list) or len(platform_inventory) != len(PLATFORM_FILES):
        raise ContractError("platform evidence inventory is invalid")
    expected_platform = set(PLATFORM_FILES)
    observed_platform: set[str] = set()
    for item in platform_inventory:
        if (
            not isinstance(item, dict)
            or set(item) != {"path", "sha256", "size"}
            or item.get("path") not in expected_platform
            or item.get("path") in observed_platform
            or DIGEST.fullmatch(str(item.get("sha256", ""))) is None
            or not isinstance(item.get("size"), int)
            or isinstance(item.get("size"), bool)
            or item["size"] <= 0
        ):
            raise ContractError("platform evidence inventory entry is invalid")
        relative = str(item["path"])
        candidate = root.joinpath(*pathlib.PurePosixPath(relative).parts)
        info = regular(candidate)
        if info.st_size != item["size"] or digest_file(candidate) != item["sha256"]:
            raise ContractError("platform evidence inventory drifted")
        observed_platform.add(relative)
    if observed_platform != expected_platform or closure.get("platform_files_sha256") != digest_bytes(
            canonical(platform_inventory)):
        raise ContractError("platform evidence inventory closure drifted")
    observed["AIENIE_MIGRATION_ARTIFACT_SHA256"] = artifact
    return observed


def validate_migration_artifacts(root: pathlib.Path) -> tuple[str, int]:
    manifest, raw = strict_json(root / ARTIFACT_MANIFEST)
    if set(manifest) != {"artifacts", "canonical_component_id", "schema_version"} \
            or manifest.get("schema_version") != "aienie-production-migration-artifacts-v1" \
            or manifest.get("canonical_component_id") != COMPONENT:
        raise ContractError("migration artifact manifest identity drifted")
    artifacts = manifest.get("artifacts")
    if not isinstance(artifacts, list) or len(artifacts) != 18:
        raise ContractError("migration artifact closure is incomplete")
    expected_fixed = {
        "backend/app.jar", "backend/production-migration-entrypoint.sh", LEDGER,
        "release/production-migration-executor",
    }
    observed_paths: set[str] = set()
    migration_versions: set[int] = set()
    for item in artifacts:
        if not isinstance(item, dict) or set(item) != {"mode", "path", "sha256", "size"}:
            raise ContractError("migration artifact entry is invalid")
        relative = item.get("path")
        if not isinstance(relative, str) or relative in observed_paths:
            raise ContractError("migration artifact path is invalid")
        match = MIGRATION_PATH.fullmatch(relative)
        if relative not in expected_fixed and match is None:
            raise ContractError("migration artifact path is outside closure")
        if match is not None:
            migration_versions.add(int(match.group(1)))
        path = root.joinpath(*pathlib.PurePosixPath(relative).parts)
        info = regular(path)
        if item.get("mode") != f"{stat.S_IMODE(info.st_mode):04o}" or item.get("size") != info.st_size \
                or item.get("sha256") != digest_file(path):
            raise ContractError("migration artifact entry drifted")
        observed_paths.add(relative)
    if not expected_fixed.issubset(observed_paths) or migration_versions != set(range(1, 15)):
        raise ContractError("Flyway artifact closure is incomplete")
    ledger, ledger_raw = strict_json(root / LEDGER)
    migrations = ledger.get("migrations")
    if (
        set(ledger) != {"authorization", "canonical_component_id", "latest_version", "location", "migrations", "schema_version"}
        or ledger.get("schema_version") != "aienie-production-flyway-ledger-v2"
        or ledger.get("canonical_component_id") != COMPONENT
        or ledger.get("latest_version") != "14"
        or ledger.get("location") != "filesystem:/app/release/migrations/sql"
        or ledger.get("authorization") != {
            "minimum_release_manifest_version": 4,
            "outer_signature_required": True,
            "restore_point_required_before_execute": True,
        }
        or not isinstance(migrations, list) or len(migrations) != 14
    ):
        raise ContractError("AINovel Flyway ledger drifted")
    for version, item in enumerate(migrations, 1):
        if not isinstance(item, dict) or set(item) != {"path", "sha256", "version"} \
                or item.get("version") != str(version) or MIGRATION_PATH.fullmatch(str(item.get("path", ""))) is None \
                or item.get("sha256") != digest_file(root / str(item["path"])):
            raise ContractError("AINovel Flyway ledger entry drifted")
    return digest_bytes(raw), len(migrations)


def compose_environment(uid: int, gid: int, platform: dict[str, str]) -> dict[str, str]:
    environment = {
        "PATH": "/usr/bin:/bin", "LC_ALL": "C",
        "AIENIE_RUNTIME_UID": str(uid), "AIENIE_RUNTIME_GID": str(gid),
    }
    for _, variable in IMAGE_BINDINGS:
        reference = platform.get(variable, "")
        if IMAGE_REFERENCE.fullmatch(reference) is None:
            raise ContractError("signed runtime image environment is incomplete")
        environment[variable] = reference
    return environment


def compose_network(root: pathlib.Path, uid: int, gid: int, platform: dict[str, str]) -> None:
    environment = compose_environment(uid, gid, platform)
    command = [
        "/usr/bin/docker", "--host", "unix:///var/run/docker.sock", "compose",
        "--project-directory", str(root), "-p", PROJECT, "-f", str(root / "docker-compose.yml"),
        "config", "--format", "json",
    ]
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=environment,
                            timeout=120, check=False)
    if result.returncode != 0:
        raise ContractError("production Compose render was rejected")
    try:
        value = json.loads(result.stdout.decode("utf-8"))
        networks = value["networks"]
        key, definition = next(iter(networks.items()))
        if len(networks) != 1 or not isinstance(definition, dict):
            raise ValueError
        name = definition.get("name") or key
    except (KeyError, TypeError, ValueError, StopIteration, UnicodeError, json.JSONDecodeError) as error:
        raise ContractError("production Compose network is invalid") from error
    inspected = subprocess.run(
        ["/usr/bin/docker", "--host", "unix:///var/run/docker.sock", "network", "inspect", str(name)],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=environment, timeout=60, check=False,
    )
    if inspected.returncode != 0:
        raise ContractError("production network must exist before migration precheck")
    try:
        network = json.loads(inspected.stdout.decode("utf-8"))[0]
        labels = network.get("Labels") or {}
    except (IndexError, TypeError, UnicodeError, json.JSONDecodeError) as error:
        raise ContractError("production network inspection is invalid") from error
    if labels.get("com.docker.compose.project") != PROJECT or labels.get("com.docker.compose.network") != key:
        raise ContractError("production network labels drifted")


def run_container(
    root: pathlib.Path,
    uid: int,
    gid: int,
    action: str,
    platform: dict[str, str],
    restore_parent: pathlib.Path | None = None,
) -> dict[str, Any]:
    environment = compose_environment(uid, gid, platform)
    command = [
        "/usr/bin/docker", "--host", "unix:///var/run/docker.sock", "compose",
        "--project-directory", str(root), "-p", PROJECT, "-f", str(root / "docker-compose.yml"),
        "run", "--rm", "--no-deps", "-T", "--entrypoint", CONTAINER_ENTRYPOINT,
    ]
    if restore_parent is not None:
        command.extend(["-v", f"{restore_parent}:/run/aienie/migration-restore:rw"])
    command.extend(["backend", action])
    result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=environment,
                            timeout=3600, check=False)
    if result.returncode != 0 or len(result.stdout) > 64 * 1024:
        raise ContractError("one-shot database migration container was rejected")
    try:
        value = json.loads(result.stdout.decode("utf-8"), object_pairs_hook=reject_duplicates)
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ContractError("database migration receipt is invalid") from error
    expected = {
        "action", "applied_entry_count", "canonical_component_id", "current_id",
        "migration_checksum_sha256", "mutation_performed", "pending_entry_count_after",
        "pending_entry_count_before", "schema_version", "status",
    }
    if (
        not isinstance(value, dict) or set(value) != expected or canonical(value) != result.stdout
        or value.get("action") != action or value.get("canonical_component_id") != COMPONENT
        or value.get("schema_version") != "aienie-production-migration-database-result-v1"
        or any(not isinstance(value.get(key), int) or isinstance(value.get(key), bool) or value[key] < 0
               for key in ("applied_entry_count", "pending_entry_count_before", "pending_entry_count_after"))
        or not isinstance(value.get("mutation_performed"), bool)
    ):
        raise ContractError("database migration receipt contract drifted")
    if action == "checkpoint":
        if value.get("status") != "checkpoint-created" or value.get("current_id") != "none" \
                or value.get("migration_checksum_sha256") != "none" \
                or any(value.get(key) != 0 for key in (
                    "applied_entry_count", "pending_entry_count_before", "pending_entry_count_after")) \
                or value.get("mutation_performed"):
            raise ContractError("checkpoint result contract drifted")
        return value
    ledger_sha = digest_file(root / LEDGER)
    if value.get("current_id") != "V14" or value.get("migration_checksum_sha256") != ledger_sha:
        raise ContractError("database migration identity drifted")
    before = value["pending_entry_count_before"]
    after = value["pending_entry_count_after"]
    applied = value["applied_entry_count"]
    mutated = value["mutation_performed"]
    if action == "precheck":
        if value.get("status") != ("current" if before == 0 else "pending") or after != before or applied != 0 or mutated:
            raise ContractError("read-only database precheck result drifted")
    elif action == "execute":
        if value.get("status") != "current" or after != 0 or applied != before or mutated != (before > 0):
            raise ContractError("database execute result drifted")
    elif value.get("status") != "current" or before != 0 or after != 0 or applied != 0 or mutated:
        raise ContractError("database reconcile result drifted")
    return value


def restore_point(action: str, uid: int) -> tuple[pathlib.Path | None, str | None]:
    if action == "precheck":
        if os.environ.get("AIENIE_MIGRATION_RESTORE_POINT_REF") or os.environ.get(
                "AIENIE_MIGRATION_RESTORE_POINT_SHA256"):
            raise ContractError("read-only precheck received restore-point authority")
        return None, None
    reference = os.environ.get("AIENIE_MIGRATION_RESTORE_POINT_REF", "")
    if RESTORE_REF.fullmatch(reference) is None:
        raise ContractError("restore-point reference is outside invocation authority")
    path = pathlib.Path(reference)
    parent = path.parent
    info = parent.lstat()
    if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode) or parent.resolve(strict=True) != parent \
            or info.st_uid != uid or stat.S_IMODE(info.st_mode) != 0o700:
        raise ContractError("restore-point directory ownership is invalid")
    observed = None
    if path.exists() or path.is_symlink():
        file_info = regular(path, {0o600})
        if file_info.st_uid != uid:
            raise ContractError("restore-point file ownership is invalid")
        observed = digest_file(path)
    expected = os.environ.get("AIENIE_MIGRATION_RESTORE_POINT_SHA256", "")
    if action == "execute" and expected:
        raise ContractError("execute cannot consume pre-authorized restore-point content")
    if action == "reconcile" and (observed is None or DIGEST.fullmatch(expected) is None or observed != expected):
        raise ContractError("restore point is unavailable or drifted for reconciliation")
    return path, observed


def main(argv: list[str]) -> int:
    if len(argv) != 3 or argv[1] not in {"precheck", "execute", "reconcile"} or argv[2] != COMPONENT:
        raise ContractError("migration executor CLI is invalid")
    action = argv[1]
    executable = pathlib.Path(__file__).resolve(strict=True)
    root = executable.parent.parent
    if executable != root / "release/production-migration-executor" or root.is_symlink() \
            or root.resolve(strict=True) != root:
        raise ContractError("migration executor escaped the candidate")
    regular(executable, {0o555})
    env_info = regular(root / "env.txt", {0o400, 0o600})
    if env_info.st_uid == 0:
        raise ContractError("protected runtime owner must be non-root")
    uid, gid = env_info.st_uid, env_info.st_gid
    invocation = injected_digest("AIENIE_MIGRATION_INVOCATION_SHA256")
    target_snapshot = injected_digest("AIENIE_MIGRATION_TARGET_SNAPSHOT_SHA256")
    platform = validate_platform(root)
    artifact_manifest_sha, ledger_count = validate_migration_artifacts(root)
    compose_network(root, uid, gid, platform)
    restore, restore_sha = restore_point(action, uid)
    if action == "execute" and restore is not None and restore_sha is None:
        checkpoint_receipt = run_container(root, uid, gid, "checkpoint", platform, restore.parent)
        if checkpoint_receipt.get("status") != "checkpoint-created" or not restore.exists():
            raise ContractError("database restore point was not created")
        os.chmod(restore, 0o600)
        with restore.open("rb") as handle:
            os.fsync(handle.fileno())
        restore_sha = digest_file(restore)
    if action != "precheck" and (restore is None or restore_sha is None
                                 or regular(restore, {0o600}).st_uid != uid):
        raise ContractError("database restore point verification failed")
    database = run_container(root, uid, gid, action, platform)
    if action in {"execute", "reconcile"} and database.get("status") != "current":
        raise ContractError("database migration did not reconcile")
    receipt = {
        "action": action,
        "artifact_manifest_sha256": artifact_manifest_sha,
        "artifact_sha256": platform["AIENIE_MIGRATION_ARTIFACT_SHA256"],
        "backup_closure_sha256": platform["AIENIE_MIGRATION_BACKUP_CLOSURE_SHA256"],
        "canonical_component_id": COMPONENT,
        "database_result": database,
        "invocation_sha256": invocation,
        "ledger_entry_count": ledger_count,
        "ledger_sha256": digest_file(root / LEDGER),
        "manifest_sha256": platform["AIENIE_MIGRATION_MANIFEST_SHA256"],
        "mutation_performed": bool(database["mutation_performed"]),
        "publication_receipt_sha256": platform["AIENIE_MIGRATION_PUBLICATION_RECEIPT_SHA256"],
        "restore_point_ref": str(restore) if restore is not None else "none",
        "restore_point_sha256": restore_sha or "none",
        "schema_version": "aienie-production-migration-executor-receipt-v1",
        "status": "passed",
        "target_snapshot_sha256": target_snapshot,
    }
    sys.stdout.buffer.write(canonical(receipt))

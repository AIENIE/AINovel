# Administrator authentication policy is read from these exact OS variables.
# Allowed: local/password, local/totp, test/totp, production/totp.
ENV=local
AUTH_MODE=totp

# Store only a BCrypt hash. Never commit the password or a real hash.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD_HASH='$2b$12$replace-with-a-real-bcrypt-hash'

# Required only in totp mode. Each value must decode to exactly 32 bytes.
ADMIN_TOTP_ENCRYPTION_KEYS=v1:replace-with-base64-32-byte-key
ADMIN_TOTP_ACTIVE_KEY_VERSION=v1
ADMIN_TRUSTED_ORIGINS=https://localainovel.testhut.top
ADMIN_SESSION_COOKIE_SECURE=true

ADMIN_SESSION_MINUTES=30
ADMIN_SESSION_IDLE_MINUTES=10
ADMIN_TOTP_RECOVERY_SESSION_MINUTES=15
ADMIN_TOTP_RECOVERY_SESSION_IDLE_MINUTES=10

# Representative required runtime secrets. Supply real values outside Git.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=ainovel
JWT_AUDIENCE=ainovel-web
MYSQL_PASSWORD=replace-outside-git
DB_USERNAME=ainovel
DB_URL=jdbc:mysql://localbase.testhut.top:23306/ainovel?sslMode=DISABLED
REDIS_PASSWORD=replace-outside-git
REDIS_USERNAME=
REDIS_SSL_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=none
QDRANT_ENABLED=true
QDRANT_API_KEY=

# Local shared data services provided by the VM addressed by the aienie-wsl SSH alias.
# Resolve localbase.testhut.top through the managed DNS/hosts configuration.
# Docker Compose maps only this data-service alias to the VM; core user/AI/pay
# aliases remain Docker host-gateway mappings.
LOCALBASE_HOST_IP=172.20.0.2
MYSQL_HOST=localbase.testhut.top
MYSQL_PORT=23306
REDIS_HOST=localbase.testhut.top
REDIS_PORT=26379
QDRANT_HOST=http://localbase.testhut.top
QDRANT_PORT=26333

# For test/production only: DB_URL must use sslMode=VERIFY_IDENTITY,
# Redis must set REDIS_SSL_ENABLED=true plus ACL username/password, and
# QDRANT_HOST must be https:// with QDRANT_API_KEY set.
EXTERNAL_AI_TIMEOUT_MS=60000
EXTERNAL_BILLING_TIMEOUT_MS=5000
EXTERNAL_SESSION_TIMEOUT_MS=3000
QDRANT_CONNECT_TIMEOUT_MS=2000
QDRANT_REQUEST_TIMEOUT_MS=5000

# Required while external security fail-fast is enabled.
EXTERNAL_AI_HMAC_CALLER=replace-with-registered-caller
EXTERNAL_AI_HMAC_SECRET=replace-with-at-least-32-random-bytes
EXTERNAL_USER_SERVICE_JWT_CALLER_ID=ainovel
EXTERNAL_USER_SERVICE_JWT_ISSUER=ainovel
EXTERNAL_USER_SERVICE_JWT_SECRET=replace-with-at-least-32-random-bytes
EXTERNAL_USER_SERVICE_JWT_AUDIENCE=aienie-userservice-grpc
EXTERNAL_USER_SERVICE_JWT_TTL_SECONDS=300
EXTERNAL_USER_SERVICE_JWT_SCOPES=user.auth.session.read
EXTERNAL_PAY_SERVICE_JWT=replace-with-valid-service-jwt

# Local Aienie service endpoints.
USER_HTTP_ADDR=https://localuserservice.testhut.top
USER_GRPC_ADDR=static://localuserservice.testhut.top:12001
AI_GRPC_ADDR=static://localaiservice.testhut.top:12011
PAY_GRPC_ADDR=static://localpayservice.testhut.top:12021
SSO_CALLBACK_ORIGIN=https://localainovel.testhut.top

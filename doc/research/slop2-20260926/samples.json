    "source": "S5",
    "provenance": "real_output_excerpt",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "她决定今天不去找。至少今天不去。",
    "originalSha256": "5198edf64e974d638aab9a3bdcea0749925b4bceddc6216b43ee520149f2ca1e",
    "genre": "中文小说",

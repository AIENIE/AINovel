[
  {
    "id": "negative_parallel-1-0",
    "family": "negative_parallel",
    "split": "development",
    "sourceGroup": "S2",
    "source": "S2",
    "provenance": "real_output_excerpt",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "“不是查无此件。”她抬头看程遥，“是这个编码段从去年三月起就冻结了。这封信在邮政系统里没存在过。”",
    "originalSha256": "73d1316bebb4b68d98040bed6cc1f991e24bfe748510837c700fcba65ce38b98",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "negative_parallel-1-1",
    "family": "negative_parallel",
    "split": "development",
    "sourceGroup": "S2",
    "source": "S2",
    "provenance": "controlled_perturbation",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "“不是查无此件。”她抬头看程遥，“是这个编码段从去年三月起就冻结了。这封信在邮政系统里没存在过。”\n这不是迟到，而是命运。这不是沉默，而是成长。这不是等待，而是觉醒。这不是结束，而是开始。",
    "originalSha256": "b0357257d5eb07ea4bdd641c741e21070a6958bba46c73f3dc1d8ad0cb7f9e52",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "negative_parallel-2-0",
    "family": "negative_parallel",
    "split": "development",
    "sourceGroup": "negative_parallel-pair-1",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "不是她开的门，是门轴断了；木屑还在地上。",
    "originalSha256": "08be07eac44cc928a0e3b5cce981d19ebc69df9b4528ad246c6ccc3eca49d85a",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "negative_parallel-2-1",
    "family": "negative_parallel",
    "split": "development",
    "sourceGroup": "negative_parallel-pair-1",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "不是风在吹，是岁月在诉说。不是雨在下，是命运在叩门。不是灯在晃，是人生在起伏。",
    "originalSha256": "525af81598320b7f1934b49c36e4c979eb52d48535b7d895c915a52e1cfd3a36",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "negative_parallel-3-0",
    "family": "negative_parallel",
    "split": "development",
    "sourceGroup": "negative_parallel-pair-2",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "不是我不去，是我不能离开值班台。她把交班记录摊开。",
    "originalSha256": "6982a1ea75e6310ef754f8bbb86692d225dff72493f5c4f3fbd7d842fd595d64",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "negative_parallel-3-1",
    "family": "negative_parallel",
    "split": "development",
    "sourceGroup": "negative_parallel-pair-2",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "并非愤怒，只是觉醒。并非悲伤，只是成长。并非告别，只是启程。",
    "originalSha256": "080258edfc4424c7049a52d9ee5aea53919ba3b897b076de9f98b4508566e3fe",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "negative_parallel-4-0",
    "family": "negative_parallel",
    "split": "development",
    "sourceGroup": "negative_parallel-pair-3",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "这不是新印的票，而是旧票上改了日期。墨还湿着。",
    "originalSha256": "53e15f9a13eb08d64cabf3b99da345e728a5c57fee7b491193af6f707707b270",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "negative_parallel-4-1",
    "family": "negative_parallel",
    "split": "development",
    "sourceGroup": "negative_parallel-pair-3",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "他不是在看雨，而是在看人生。她不是在擦桌，而是在擦岁月。老人不是在锁门，而是在锁命运。",
    "originalSha256": "9623703a8ddaf97c54d4f1bbff7ad4676d6869665417aecb4f58e2a148003a4b",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "negative_parallel-5-0",
    "family": "negative_parallel",
    "split": "holdout",
    "sourceGroup": "negative_parallel-pair-4",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "与其说他拒绝，不如说他在等许可；桌上那张批条还没签字。",
    "originalSha256": "fd597681e2086afcd60643cbb189ebbeb7b2acce1065a496601b56e3dc79e719",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "negative_parallel-5-1",
    "family": "negative_parallel",
    "split": "holdout",
    "sourceGroup": "negative_parallel-pair-4",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "与其说是迟疑，不如说是蜕变。与其说是疲惫，不如说是成长。与其说是沉默，不如说是力量。",
    "originalSha256": "3ded148cf5fe13caeaf18b5a30c0d4c3fa727a701b32292408575a1c6d216d0c",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "negative_parallel-6-0",
    "family": "negative_parallel",
    "split": "holdout",
    "sourceGroup": "negative_parallel-pair-5",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "她并没有把钱退回去。她退回的是装钱的空信封。",
    "originalSha256": "a003258d607d9b05d45d7402f36031bcf1c4db101345f704cdba4e9d0c2ef762",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "negative_parallel-6-1",
    "family": "negative_parallel",
    "split": "holdout",
    "sourceGroup": "negative_parallel-pair-5",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "没有什么离别，只有新的开始；没有什么眼泪，只有成长的洗礼；没有什么挫折，只有命运的馈赠。",
    "originalSha256": "8663e2939f77f64cba701d348a06302a539d27be78409e01d1f44030d3f29add",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "dialogue_tail-1-0",
    "family": "dialogue_tail",
    "split": "development",
    "sourceGroup": "S3",
    "source": "S3",
    "provenance": "real_output_excerpt",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "“你欠我的。”程遥的声音追上来。\n\n林砚没回头。“我知道。”",
    "originalSha256": "bc36350cc2ab59992dff96228e5914bfe17c117e50abfea2ba7a596f9c562819",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "dialogue_tail-1-1",
    "family": "dialogue_tail",
    "split": "development",
    "sourceGroup": "S3",
    "source": "S3",
    "provenance": "controlled_perturbation",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "“你欠我的。”程遥的声音追上来。\n\n林砚没回头。“我知道。”\n“走吧。”他的语气里带着坚定。“现在？”她的语气里带着惊讶。“现在。”他的语气里带着决绝。",
    "originalSha256": "2442fc68c37d1fdff627a7c6ed10e96c18eb86cad32930ce5c5b69266fa409a1",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "dialogue_tail-2-0",
    "family": "dialogue_tail",
    "split": "development",
    "sourceGroup": "dialogue_tail-pair-1",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "“别出声。”她贴着门说。走廊的脚步停在门外。",
    "originalSha256": "341e191194c724992ca27240261f8b5825ca63668492af08abaa5e5f36b1526a",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "dialogue_tail-2-1",
    "family": "dialogue_tail",
    "split": "development",
    "sourceGroup": "dialogue_tail-pair-1",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "“你走。”她说，声音中充满了悲伤。“我等。”他说，声音中充满了坚定。“随你。”她说，声音中充满了无奈。",
    "originalSha256": "008622006899c01381c6ebe5eddcf0e5a7b8ff4c3e1da3dcb6a08f64886562e5",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "dialogue_tail-3-0",
    "family": "dialogue_tail",
    "split": "development",
    "sourceGroup": "dialogue_tail-pair-2",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "“账不对。”他把算盘往她面前一推。“第三行，你再算。”",
    "originalSha256": "dfa1416348f32813d068308334b28d2a4385f71e71dcb800d69d389e75cd85ee",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "dialogue_tail-3-1",
    "family": "dialogue_tail",
    "split": "development",
    "sourceGroup": "dialogue_tail-pair-2",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "“我怕。”她说，这句话透露出恐惧。“我懂。”他说，这句话透露出理解。“谢谢。”她说，这句话透露出感激。",
    "originalSha256": "3f696e785683c905554703a3a9312b5454772e346d660eb4e8910ffb3df22738",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "dialogue_tail-4-0",
    "family": "dialogue_tail",
    "split": "development",
    "sourceGroup": "dialogue_tail-pair-3",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "“好。”她把钥匙递过去。过了一会又说：“备用的也给你。”",
    "originalSha256": "504077c24c51e89208a62cac557af4eb1c3936dffcb9b9f0c4890c2aa69b2137",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "dialogue_tail-4-1",
    "family": "dialogue_tail",
    "split": "development",
    "sourceGroup": "dialogue_tail-pair-3",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "“好。”她轻声说道，话音透着温柔。“不。”他沉声说道，话音透着坚定。“罢了。”她低声说道，话音透着失落。",
    "originalSha256": "09a2f0bd154616d311c5f513760a58c00bba1ca2620b7ba6583e2d720ef4a392",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "dialogue_tail-5-0",
    "family": "dialogue_tail",
    "split": "holdout",
    "sourceGroup": "dialogue_tail-pair-4",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "“我没看见。”证人说得很响。门外记录员停下笔，示意他小声。",
    "originalSha256": "05d367aa6dc4367d30988d1d7f81b134c60a68997f92866298410b100da22f77",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "dialogue_tail-5-1",
    "family": "dialogue_tail",
    "split": "holdout",
    "sourceGroup": "dialogue_tail-pair-4",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "“不去。”她答，字字都是决绝。“等你。”他答，字字都是执着。“别等。”她答，字字都是悲伤。",
    "originalSha256": "eb6e48ad784ef4cac01190c163d44ffa21b7497fc6eb0b0c354f629efbda0275",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "dialogue_tail-6-0",
    "family": "dialogue_tail",
    "split": "holdout",
    "sourceGroup": "dialogue_tail-pair-5",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "“吃了吗？”父亲仍旧这样问。她这回没敷衍：“还没有。”",
    "originalSha256": "9f0799f16b0ac165e68afee23e8ac1b33a8e3fc0a41fc8b4ce59a79bf07eb931",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "dialogue_tail-6-1",
    "family": "dialogue_tail",
    "split": "holdout",
    "sourceGroup": "dialogue_tail-pair-5",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "“我知道了。”她说，显然已经明白。“我生气了。”他说，显然十分愤怒。“我很难过。”她说，显然内心悲伤。",
    "originalSha256": "70781dc0464e4f10e31e51c3634c9b39cf3055803168cc40137b0c22aa290da9",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "body_action-1-0",
    "family": "body_action",
    "split": "development",
    "sourceGroup": "S5",
    "source": "S5",
    "provenance": "real_output_excerpt",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "书架不晃了。她用手推了推，又推了推。然后开始把书放回去。",
    "originalSha256": "952141718e22d3ef4a130fb390ac81e150813b220a91600d4b1243c7dc7e9c3e",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "body_action-1-1",
    "family": "body_action",
    "split": "development",
    "sourceGroup": "S5",
    "source": "S5",
    "provenance": "controlled_perturbation",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "书架不晃了。她用手推了推，又推了推。然后开始把书放回去。\n她把书拿起又放下。他把杯拿起又放下。老人把笔拿起又放下。孩子把伞拿起又放下。",
    "originalSha256": "69d7df7f9c97a3141307d5c16e21b14d0f6e18df456f97207a757b4219dc3196",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "body_action-2-0",
    "family": "body_action",
    "split": "development",
    "sourceGroup": "body_action-pair-1",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "他拧开瓶盖，发现封膜还在，便把瓶子放到灯下。",
    "originalSha256": "ed108275179d6c75e222b2d48c50eed14ab8d68cba74e093c2239ca6eaa32015",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "body_action-2-1",
    "family": "body_action",
    "split": "development",
    "sourceGroup": "body_action-pair-1",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "他嘴角微微上扬，眼神变得坚定。她嘴角微微上扬，眼神变得坚定。老人嘴角微微上扬，眼神变得坚定。",
    "originalSha256": "8c19d63fe94258b76aa0865eab338d7791a96eb1c640ebd13ed2011b270228d9",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "body_action-3-0",
    "family": "body_action",
    "split": "development",
    "sourceGroup": "body_action-pair-2",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "她摸门闩，烫手。换用湿布裹住，才把它抽出来。",
    "originalSha256": "c533ae3a2d2bd80fe09f0bcc3785b78757d4f68afb00f3634ea32c3696f4a3bf",
    "genre": "中文小说",
    "tone": "",
    "reason": "具体事实、人物意图或有功能的重复，应允许保留"
  },
  {
    "id": "body_action-3-1",
    "family": "body_action",
    "split": "development",
    "sourceGroup": "body_action-pair-2",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "她垂下眼，又抬起眼。他垂下眼，又抬起眼。门边的人垂下眼，又抬起眼。",
    "originalSha256": "5bfe95cfbb8d2a681d085b41cee5596f6709145dde6d6f4efb40a0aec788e728",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },
  {
    "id": "body_action-4-0",
    "family": "body_action",
    "split": "development",
    "sourceGroup": "body_action-pair-3",
    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",

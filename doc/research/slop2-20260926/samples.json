    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": true,
    "labelAuthority": "agent_judgment",
    "text": "忧愁是一片海，离别是一片海，沉默是一片海，等待也是一片海。",
    "originalSha256": "a409c00beb5a5bf66a03cbed2aaf5cdd3828e407ad24f7fe224c937169e2cae1",
    "genre": "中文小说",
    "tone": "",
    "reason": "同构模板密集堆叠，信息推进不足"
  },

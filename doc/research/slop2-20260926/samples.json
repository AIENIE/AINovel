    "source": null,
    "provenance": "agent_constructed",
    "expectedIntervention": false,
    "labelAuthority": "agent_judgment",
    "text": "她算完路费，知道这次只能一个人去。另一张票退了。",
    "originalSha256": "6055a1a3711dd4db6e144ec1a9d301c504cb332e5d8a2f6a9b71b2c3eb7a37ab",
    "genre": "中文小说",
